classDiagram
    class Owner {
        +str name
        +int available_minutes
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_pet(name: str) Pet or None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(description: str) None
        +pending_tasks() list~Task~
    }

    class Task {
        +str description
        +int duration_minutes
        +str priority
        +str time
        +str frequency
        +bool completed
        +str pet_name
        +date due_date
        +priority_value() int
        +mark_complete() Task or None
    }

    class Scheduler {
        +Owner owner
        +list~Task~ scheduled
        +list~Task~ skipped
        +list~str~ conflicts
        +get_pending_tasks(on_date: date) list~Task~
        +mark_task_complete(task: Task) Task or None
        +filter_tasks(pet_name: str, completed: bool) list~Task~
        +sort_tasks(tasks: list~Task~) list~Task~
        +sort_by_time(tasks: list~Task~) list~Task~
        +detect_conflicts(tasks: list~Task~) list~str~
        +generate_plan() list~Task~
        +total_scheduled_minutes() int
        +explain_plan() str
    }

    class TimeHelpers {
        <<utility>>
        +time_to_minutes(time: str) int or None
        +format_minutes(total: int) str
    }

    Owner "1" *-- "*" Pet : owns
    Pet "1" *-- "*" Task : needs
    Task ..> Pet : pet_name (by name)
    Task ..> Task : mark_complete() creates next occurrence
    Scheduler --> "1" Owner : plans for
    Scheduler ..> Task : sorts, filters, schedules, checks conflicts
    Scheduler ..> Pet : adds next occurrence
    Scheduler ..> TimeHelpers : uses
