classDiagram
    class Owner {
        +str name
        +int available_minutes
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(name: str) None
    }

    class Task {
        +str name
        +int duration_minutes
        +str priority
        +str category
        +bool completed
        +priority_value() int
    }

    class Scheduler {
        +Owner owner
        +list~Task~ scheduled
        +list~Task~ skipped
        +generate_plan() list~Task~
        +sort_tasks(tasks: list~Task~) list~Task~
        +explain_plan() str
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : needs
    Scheduler --> Owner : plans for
